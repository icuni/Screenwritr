{
  "name": "screenwritr",
  "version": "0.1.1",
  "private": true,
  "description": "A considered home for stories. Local-first screenwriting and creative development by ICUNI.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "ICUNI",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "desktop": "node scripts/desktop.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/desktop-smoke.mjs",
    "package": "npm run build && node scripts/package-desktop.mjs",
    "dist:win": "npm run package && electron-builder --prepackaged release/Screenwritr-0.1.1-win-x64 --win nsis --publish never",
    "mcp": "node mcp/server.mjs",
    "check": "npm run build && npm test",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@tiptap/core": "^3.7.0",
    "@tiptap/extension-placeholder": "^3.7.0",
    "@tiptap/pm": "^3.7.0",
    "@tiptap/react": "^3.7.0",
    "@tiptap/starter-kit": "^3.7.0",
    "docx": "^9.5.1",
    "fast-xml-parser": "^5.3.0",
    "htmlparser2": "^10.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "playwright": "^1.56.0",
    "@electron/asar": "^3.4.1"
  },
  "build": {
    "appId": "org.icuni.screenwritr",
    "productName": "Screenwritr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "lib/**/*",
      "mcp/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Screenwritr-${version}-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
